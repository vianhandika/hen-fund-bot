# --- BYBIT / BOT BASE ---
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_PRIVATE_URL=wss://stream.bybit.com/v5/private
BYBIT_API_KEY=xxx
BYBIT_API_SECRET=xxx 
BYBIT_ACCOUNT_TYPE=unified
BYBIT_LEVERAGE=10
ENTRY_USD=20
ENTRY_MULT=1

BOT_MODE=live
TZ=Asia/Jakarta
DATA_DIR=./src/storage/files
WINDOW_SKIP_START=23:00
WINDOW_SKIP_END=04:00

WS_SELFTEST=1
WS_RECV_WINDOW=5000

DISCORD_TOKEN=xxx 
DISCORD_ALERT_CHANNEL_ID=xxx
DISCORD_MANUAL_CHANNEL_ID=xxx

# ==========================
#  STRATEGY (SHORT ONLY)
# ==========================

# --- TP (langsung dari AVG, bukan dari TP1/TP2) ---
# 2.5%, 5%, 10%
STRAT_TP1_PCT=0.025
STRAT_TP2_PCT=0.05
STRAT_TP3_PCT=0.10

# Lock profit setelah TP1 (SHORT):
# 0.005 = 0.5% dari AVG, nanti dipakai ketika kita wiring di watcher
LOCK_AFTER_TP1=0.005

# --- Trim per TP (3 TP) ---
# total sebaiknya <= 1.0, contoh: 40% + 30% + 30%
STRAT_TRIM_PCTS=0.4,0.3,0.3

# --- DCA steps (jarak harga dari entry) ---
# 4 leg: 5%, 15%, 35%, 75%
STRAT_DCA_STEPS=0.05,0.15,0.35,0.75

# --- DCA size multipliers (kelipatan qty entry) ---
# 4 leg: 1.5x, 2.25x, 3.4x, 5.1x
STRAT_DCA_MULTS=1.5,2.25,3.4,5.1
