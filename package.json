{
  "name": "dca-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/app.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\"",
    "test": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bybit-api": "^4.4.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "discord.js": "^14.24.2",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^7.0.6",
    "isomorphic-ws": "^5.0.0",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
